# Copia este archivo como .env (no se sube a GitHub) y define estas variables en tu entorno.
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True

# Correo para recuperar contraseñas (Gmail con contraseña de aplicación)
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion

# Opcional: ruta a otra base de datos SQLite
# DJANGO_DB_PATH=C:/ruta/a/otra.sqlite3
