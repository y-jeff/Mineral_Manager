# Copia este archivo como .env en la raíz del proyecto (no se sube a GitHub).
# En tu computador no hace falta: sin .env la app corre en modo desarrollo.

# --- Producción ---
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=tu-usuario.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-usuario.pythonanywhere.com

# --- Opcional: correo para recuperar contraseñas (Gmail con contraseña de aplicación) ---
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion

# --- Opcional: ruta a otra base de datos SQLite ---
# DJANGO_DB_PATH=/ruta/a/otra.sqlite3
